# ─── Chick Agent Platform Configuration Template ─────────────────
# Copy this file to .env and uncomment/set values as needed.
# All values can also be set via environment variables (recommended for production).

# ─── Database ─────────────────────────────────────────────────────
# Driver: sqlite3 or postgres
# CHICK_DB_DRIVER=sqlite3
# CHICK_DB_DSN=file:dev.db?_pragma=journal_mode(WAL)

# ─── Server ───────────────────────────────────────────────────────
# CHICK_PORT=8080

# ─── Authentication ───────────────────────────────────────────────
# JWT secret for GraphQL login sessions. If empty, a random secret is
# generated on each startup (invalidates all sessions on restart).
# CHICK_JWT_SECRET=your-secret-here

# Admin agent token for seed data. If empty, a random token is
# generated and printed in the logs on first run.
# CHICK_ADMIN_TOKEN=your-admin-token

# Allow human users to self-register via GraphQL mutations.
# CHICK_ALLOW_HUMAN_REGISTRATION=false

# MCP agent token for stdio mode (required when using --stdio).
# CHICK_AGENT_TOKEN=your-agent-token

# ─── CORS ─────────────────────────────────────────────────────────
# Comma-separated allowed origins. "*" allows all origins.
# CHICK_ALLOWED_ORIGINS=*

# ─── MCP ──────────────────────────────────────────────────────────
# IP CIDR restrictions for MCP endpoints (comma-separated).
# Empty = allow all.
# CHICK_MCP_ALLOWED_CIDRS=

# ─── Matching Engine ──────────────────────────────────────────────
# Interval between checks for offline agents (Go duration format).
# CHICK_MATCHING_CHECK_INTERVAL=60s
# Timeout before marking an offline agent's assignments as blocked.
# CHICK_MATCHING_OFFLINE_TIMEOUT=5m

# ─── Default Project ──────────────────────────────────────────────
# Project ID for the submit_requirement MCP tool.
# CHICK_REQUIREMENT_PROJECT_ID=0

# ─── Redis (Notifications) ────────────────────────────────────────
# CHICK_REDIS_ADDR=localhost:6379
# CHICK_REDIS_PASSWORD=
# CHICK_REDIS_DB=1

# ─── Debug ────────────────────────────────────────────────────────
# CHICK_PPROF_ENABLED=false
# CHICK_DEV_MODE=false
