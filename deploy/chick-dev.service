[Unit]
Description=Morning Glory Agent Platform (Dev)
After=network.target

[Service]
Type=simple
WorkingDirectory=/root/morning-glory
ExecStart=/root/morning-glory/bin/morning-glory
Restart=always
RestartSec=3
Environment=MORNING_GLORY_DB_DRIVER=sqlite3
Environment=MORNING_GLORY_DB_DSN=file:dev.db?_pragma=journal_mode(WAL)
Environment=MORNING_GLORY_PORT=8082
Environment=MORNING_GLORY_ALLOW_HUMAN_REGISTRATION=false
Environment=MORNING_GLORY_JWT_SECRET=morning-glory-dev-secret-key-2024
Environment=MORNING_GLORY_ALLOWED_ORIGINS=*
StandardOutput=append:/var/log/morning-glory-dev.log
StandardError=append:/var/log/morning-glory-dev.log

[Install]
WantedBy=multi-user.target
