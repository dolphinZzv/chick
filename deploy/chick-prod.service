[Unit]
Description=Morning Glory Agent Platform (Production)
After=network.target postgresql.service
Requires=postgresql.service

[Service]
Type=simple
WorkingDirectory=/opt/morning-glory
ExecStart=/opt/morning-glory/morning-glory-server
Restart=always
RestartSec=3
EnvironmentFile=-/etc/default/morning-glory-prod
Environment=MORNING_GLORY_DB_DRIVER=postgres
Environment=MORNING_GLORY_DB_DSN=postgres://morning-glory:morning-glory@localhost:5432/morning-glory?sslmode=disable
Environment=MORNING_GLORY_PORT=18080
Environment=MORNING_GLORY_ALLOWED_ORIGINS=*
StandardOutput=append:/var/log/morning-glory-prod.log
StandardError=append:/var/log/morning-glory-prod.log

[Install]
WantedBy=multi-user.target
